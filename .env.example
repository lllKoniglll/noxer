# Optional Ollama-compatible endpoint used by the backend.
# For Ollama running on the Mac mini host, use this value:
# Ollama runs as a separate container on the same Docker network as Noxer.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
# Optional; leave blank if the endpoint does not require one.
OLLAMA_API_KEY=
# Authentik groups with this prefix define the shared workspace.
NOXER_WORKSPACE_GROUP_PREFIX=noxer-workspace-
# Persistent host directory, relative to this Compose file by default.
NOXER_DATA_PATH=./data
NOXER_MAX_FILE_BYTES=26214400
