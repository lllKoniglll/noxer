# Optional Ollama-compatible endpoint used by the backend. Uploaded SIE4 files
# are processed in memory and are never written to the container filesystem.
# For Ollama running on the Mac mini host, use this value:
# Ollama runs as a separate container on the same Docker network as Noxer.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
# Optional; leave blank if the endpoint does not require one.
OLLAMA_API_KEY=
